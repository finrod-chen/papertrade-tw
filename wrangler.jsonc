// Cloudflare Workers + Containers 部署設定
// 文件：https://developers.cloudflare.com/containers/
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "papertrade-tw",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "containers": [
    {
      "class_name": "PaperTradeContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"   // 1 GiB RAM，跑 pandas/backtrader 足夠
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PAPERTRADE", "class_name": "PaperTradeContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PaperTradeContainer"] }
  ],
  "observability": { "enabled": true }
}
